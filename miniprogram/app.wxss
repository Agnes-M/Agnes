page {
  background-color: #f5f6f8;
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.breadcrumb {
  padding: 20rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  font-size: 26rpx;
  color: #666;
  word-break: break-all;
}

.breadcrumb .highlight {
  color: #1677ff;
  font-weight: 500;
}

.search-bar {
  padding: 20rpx 32rpx;
  background: #fff;
}

.search-input {
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:active {
  background: #f9f9f9;
}

.list-item-main {
  flex: 1;
  min-width: 0;
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.list-item-sub {
  font-size: 24rpx;
  color: #999;
}

.list-item-arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 16rpx;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 32rpx;
  color: #999;
  font-size: 28rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: #1677ff;
  color: #fff;
  padding: 20rpx 36rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.35);
  z-index: 100;
}

.fab-btn:active {
  opacity: 0.85;
}

.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.status-adding {
  background: #e6f4ff;
  color: #1677ff;
}

.status-onboard {
  background: #f6ffed;
  color: #52c41a;
}

.status-offboard {
  background: #fff7e6;
  color: #fa8c16;
}

.status-low-priority {
  background: #f5f5f5;
  color: #999;
}
