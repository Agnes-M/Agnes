.form-wrapper {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.update-info {
  padding: 20rpx 32rpx;
  background: #fffbe6;
  font-size: 24rpx;
  color: #ad8b00;
  border-bottom: 1rpx solid #ffe58f;
}

.form-section {
  background: #fff;
  margin-top: 16rpx;
}

.form-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  padding: 8rpx 0;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding: 8rpx 0;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 28rpx;
  color: #333;
}

.placeholder {
  color: #ccc;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.tngs-field {
  background: #f0f7ff;
}

.tngs-field .form-label {
  color: #1677ff;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.save-btn {
  background: #1677ff;
  color: #fff;
  font-size: 30rpx;
  border-radius: 8rpx;
  padding: 20rpx 0;
  width: 100%;
}

.save-btn[disabled] {
  opacity: 0.6;
}
